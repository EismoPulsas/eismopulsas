# Copy to mobile/.env (gitignored) and pick ONE value. EXPO_PUBLIC_* values are
# embedded in the app and public — never put secrets here.
#
# Android emulator talking to `npm run dev` on this machine:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
#
# Physical phone on the same Wi-Fi (use the "Network" URL that `npm run dev` prints):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
#
# Deployed BFF (Vercel production or an unprotected Preview):
# EXPO_PUBLIC_API_BASE_URL=https://<deployment>.vercel.app
